{
  "name": "official-application-maker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "সরকারি প্রাথমিক বিদ্যালয়ের শিক্ষক ও শিক্ষার্থীদের জন্য বাংলা দরখাস্ত প্রস্তুতকারক PWA",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port=3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/generate-icons.mjs && node scripts/generate-og-image.mjs",
    "size": "node scripts/size-report.mjs"
  },
  "dependencies": {
    "html2canvas-pro": "^2.5.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.19"
  }
}
