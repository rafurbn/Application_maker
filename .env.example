# কপি করে .env.local নামে রাখুন। সব কী ঐচ্ছিক — না দিলে অ্যাপটি পুরোপুরি লোকালভাবেই চলবে।

# --- Supabase (ঐচ্ছিক: লাইভ পরিসংখ্যান) ---
# Supabase console → Project Settings → API থেকে মান নিন।
VITE_SUPABASE_URL="https://XXXXXXXXXXXX.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# SERVICE_ROLE_KEY কখনোই এখানে বা ক্লায়েন্টে দেবেন না।
# এটি শুধু Supabase-এর সিক্রেটে থাকে (নিচের কমান্ড দেখুন)।

# --- অ্যাডমিন ---
# ADMIN_TOKEN ও supabase secrets set দিয়ে পাঠানো হয়, রিপোতে নয়।
# Vercel-এ শুধু /admin-panel খোলার জন্যই এই টোকেন লাগবে (পাসওয়ার্ড হিসেবে)।

# --- বিজ্ঞাপন (ফেজ ২, ঐচ্ছিক) ---
# AdSense অনুমোদন পাওয়ার পর ক্লায়েন্ট আইডি দিন (ca-pub-XXXXXXXXXXXXXXXX)।
# না দিলে বিজ্ঞাপনের জায়গাটি সম্পূর্ণ লুকানো থাকে — খালি বক্স দেখায় না।
# চালু করার দিন vercel.json-এর CSP-তে যোগ করুন:
#   script-src-এ https://pagead2.googlesyndication.com
#   frame-src-এ https://googleads.g.doubleclick.net
VITE_ADSENSE_CLIENT=""
